const fs = require('node:fs')
const path = require('node:path')
const model = require(process.argv[2])
const sourceRoot = process.argv[3]
const qmlSources = [
  'Panel.qml',
  'BluetoothAudioPolicyEngine.qml',
  'BluetoothDeviceDetails.qml',
  'BluetoothDeviceIcon.qml',
  'BluetoothDeviceRow.qml'
]
const sources = Object.fromEntries(qmlSources.map(file => [
  file, fs.readFileSync(path.join(sourceRoot, file), 'utf8')
]))
const panelSource = qmlSources.map(file => sources[file]).join('\n')
const controllerSource = sources['Panel.qml']
const policySource = sources['BluetoothAudioPolicyEngine.qml']

assert.match(panelSource, /audioControlInstalled/)
assert.match(panelSource, /var payload = '\{"tab":"bluetooth"\}'/)
