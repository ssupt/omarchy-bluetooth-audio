#!/bin/bash

set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
TEST_DIR="$ROOT/test"

fail() {
  echo "FAIL: $*" >&2
  exit 1
}

for script in "$ROOT"/scripts/* "$TEST_DIR"/mocks/*; do
  bash -n "$script" || fail "bash syntax: ${script##*/}"
done
echo "PASS: helper syntax"

node - "$ROOT/Model.js" "$ROOT/Panel.qml" <<'JS'
const assert = require('node:assert/strict')
const fs = require('node:fs')
const model = require(process.argv[2])
const panelSource = fs.readFileSync(process.argv[3], 'utf8')

assert.match(panelSource, /audioControlInstalled/)
assert.match(panelSource, /var payload = '\{"tab":"bluetooth"\}'/)
assert.match(panelSource, /summon\("ssupt\.audio-control", payload\)/)

const profiles = {
  '001122334455': {
    activeProfile: 'a2dp-sink-aac',
    activeCodec: 'AAC',
    profiles: [
      { value: 'a2dp-sink-aac', codec: 'AAC', label: 'High fidelity · AAC', hasInput: false },
      { value: 'headset-head-unit-msbc', codec: 'mSBC', label: 'Headset + microphone · mSBC', hasInput: true }
    ]
  }
}

const state = model.audioProfileState(profiles, '00:11:22:33:44:55')
assert.equal(state.activeCodec, 'AAC')
assert.deepEqual(model.audioProfileOptions(state), [
  { value: 'a2dp-sink-aac', label: 'High fidelity · AAC' },
  { value: 'headset-head-unit-msbc', label: 'Headset + microphone · mSBC' }
])
assert.equal(model.audioProfileCodec(state, 'headset-head-unit-msbc'), 'mSBC')
assert.equal(model.audioProfileHasInput(state, state.activeProfile), false)
assert.equal(model.audioProfileHasInput(state, 'headset-head-unit-msbc'), true)
assert.equal(model.audioProfileState(profiles, 'AA:BB:CC:DD:EE:FF'), null)

const audioPreferences = model.parseAudioPreferences(JSON.stringify({
  defaults: { output: 'bluez_output.00_11_22_33_44_55.1' },
  bluetoothProfiles: { '00:11:22:33:44:55': 'headset-head-unit-msbc' }
}))
assert.deepEqual(audioPreferences, {
  version: 1,
  defaults: { output: 'bluez_output.00_11_22_33_44_55.1', input: '' },
  bluetoothProfiles: { '001122334455': 'headset-head-unit-msbc' },
  bluetoothAudioPolicies: {}
})
assert.equal(model.preferredAudioProfile(
  audioPreferences, '00-11-22-33-44-55', state.profiles, state.activeProfile
), 'headset-head-unit-msbc')
assert.equal(model.preferredAudioProfile(
  audioPreferences, '00:11:22:33:44:55', [{ value: 'a2dp-sink-aac' }], state.activeProfile
), 'a2dp-sink-aac')
assert.equal(model.currentAudioProfile(
  audioPreferences, '00:11:22:33:44:55', state.profiles, state.activeProfile, ''
), 'a2dp-sink-aac')
assert.equal(model.currentAudioProfile(
  audioPreferences, '00:11:22:33:44:55', state.profiles, state.activeProfile,
  'headset-head-unit-msbc'
), 'headset-head-unit-msbc')

assert.deepEqual(model.audioPolicyOrder(), ['manual', 'output', 'output-mic'])
const parsedPolicies = model.parseAudioPreferences(JSON.stringify({
  bluetoothAudioPolicies: {
    'AA:BB:CC:DD:EE:FF': 'output',
    '00-11-22-33-44-55': 'output-mic',
    '001122334455': 'manual',
    'zz': 'output',
    '112233445566': 'bogus',
    '998877665544': 7
  }
}))
assert.deepEqual(parsedPolicies.bluetoothAudioPolicies, {
  'aabbccddeeff': 'output',
  '001122334455': 'output-mic'
})
assert.equal(model.deviceAudioPolicy(parsedPolicies, 'AA:BB:CC:DD:EE:FF'), 'output')
assert.equal(model.deviceAudioPolicy(parsedPolicies, 'aa-bb-cc-dd-ee-ff'), 'output')
assert.equal(model.deviceAudioPolicy(parsedPolicies, '00:11:22:33:44:55'), 'output-mic')
assert.equal(model.deviceAudioPolicy(parsedPolicies, '11:22:33:44:55:66'), 'manual')
assert.equal(model.deviceAudioPolicy({}, '00:11:22:33:44:55'), 'manual')
assert.equal(model.deviceAudioPolicy(null, ''), 'manual')
assert.equal(model.isValidAudioPolicy('output'), true)
assert.equal(model.isValidAudioPolicy('output-mic'), true)
assert.equal(model.isValidAudioPolicy('manual'), false)

const duplexState = {
  activeProfile: 'a2dp-sink-aac',
  activeCodec: 'AAC',
  card: 'bluez_card.00_11_22_33_44_55',
  profiles: [
    { value: 'a2dp-sink-aac', codec: 'AAC', label: 'High fidelity · AAC', hasInput: false },
    { value: 'headset-head-unit-cvsd', codec: 'CVSD', label: 'Headset + microphone · CVSD', hasInput: true },
    { value: 'headset-head-unit-msbc', codec: 'mSBC', label: 'Headset + microphone · mSBC', hasInput: true }
  ]
}
const micLessState = {
  activeProfile: 'a2dp-sink-aac',
  profiles: [{ value: 'a2dp-sink-aac', codec: 'AAC', label: 'High fidelity · AAC', hasInput: false }]
}
const duplex = model.duplexProfileOption(duplexState)
assert.deepEqual(duplex, {
  value: 'headset-head-unit-cvsd', label: 'Headset + microphone · CVSD'
})
assert.equal(model.duplexProfileOption(micLessState), null)
assert.equal(model.duplexProfileOption(null), null)

// Connect policies only apply to audio hardware, judged offline from the
// BlueZ icon class and the same label hints the glyph picker uses.
assert.equal(model.isAudioDevice('audio-headset', 'Desk headset'), true)
assert.equal(model.isAudioDevice('audio-card', ''), true)
assert.equal(model.isAudioDevice('', 'Galaxy Buds FEee'), true)
assert.equal(model.isAudioDevice('', 'MOMENTUM 4'), true)
assert.equal(model.isAudioDevice('input-keyboard', 'Keychron K2'), false)
assert.equal(model.isAudioDevice('input-mouse', 'MX Master 3S'), false)
assert.equal(model.isAudioDevice('watch', 'Generic Watch'), false)
assert.equal(model.isAudioDevice('', ''), false)

const parsedAliases = model.parseDeviceAliases(JSON.stringify({
  devices: { aliases: {
    'bluez_output.80_C3_BA_67_04_C0.1': 'Desk headset ',
    'bluez_input.80:C3:BA:67:04:C0': 'Desk mic',
    '': 'bogus',
    'bluez_output.00_00_00_00_00_00.1': 7
  } }
}))
assert.deepEqual(parsedAliases, {
  'bluez_output.80_C3_BA_67_04_C0.1': 'Desk headset',
  'bluez_input.80:C3:BA:67:04:C0': 'Desk mic'
})
assert.deepEqual(model.parseDeviceAliases('not json'), {})
assert.deepEqual(model.parseDeviceAliases('{"devices":{"aliases":{}}}'), {})
assert.equal(model.audioProfileHasInput(duplexState, 'a2dp-sink-aac'), false)
assert.equal(model.audioProfileHasInput(duplexState, 'headset-head-unit-msbc'), true)
// A saved duplex preference must be detected so the applier waits for
// WirePlumber's restore instead of switching codecs behind the user's back.
const savedDuplexPrefs = model.parseAudioPreferences(JSON.stringify({
  bluetoothProfiles: { '00:11:22:33:44:55': 'headset-head-unit-msbc' }
}))
const savedDuplex = model.preferredAudioProfile(
  savedDuplexPrefs, '00:11:22:33:44:55', model.audioProfileOptions(duplexState), '')
assert.equal(savedDuplex, 'headset-head-unit-msbc')
assert.equal(model.audioProfileHasInput(duplexState, savedDuplex), true)
const savedAacPrefs = model.parseAudioPreferences(JSON.stringify({
  bluetoothProfiles: { '00:11:22:33:44:55': 'a2dp-sink-aac' }
}))
const savedOutputOnly = model.preferredAudioProfile(
  savedAacPrefs, '00:11:22:33:44:55', model.audioProfileOptions(duplexState), '')
assert.equal(savedOutputOnly, 'a2dp-sink-aac')
assert.equal(model.audioProfileHasInput(duplexState, savedOutputOnly), false)

const device = { address: '00:11:22:33:44:55', deviceName: 'Bluetooth Headphones' }
const detailedDevice = {
  address: 'AA:BB:CC:DD:EE:FF',
  dbusPath: '/org/bluez/hci0/dev_AA_BB_CC_DD_EE_FF',
  name: 'Desk headset',
  deviceName: 'Hardware headset',
  icon: 'audio-headset',
  connected: false,
  state: 0,
  paired: true,
  bonded: true,
  pairing: false,
  trusted: true,
  blocked: false,
  wakeAllowed: true,
  batteryAvailable: true,
  battery: 0.64
}
assert.equal(model.deviceLabel(detailedDevice), 'Desk headset')
assert.equal(model.hasHumanName({ name: '00112233-4455-6677-8899-aabbccddeeff', deviceName: 'Keyboard' }), true)
assert.deepEqual(model.deviceRow(detailedDevice), {
  address: 'AA:BB:CC:DD:EE:FF',
  dbusPath: '/org/bluez/hci0/dev_AA_BB_CC_DD_EE_FF',
  name: 'Desk headset',
  deviceName: 'Hardware headset',
  icon: 'audio-headset',
  connected: false,
  state: 0,
  paired: true,
  bonded: true,
  trusted: true,
  blocked: false,
  wakeAllowed: true,
  batteryAvailable: true,
  battery: 0.64,
  pairing: false
})
const blockedDevice = {
  address: '11:22:33:44:55:66', name: 'Blocked keyboard', blocked: true
}
assert.deepEqual(model.deviceLists([blockedDevice]).known, [blockedDevice])
const sink = {
  id: 40,
  name: 'bluez_output.00_11_22_33_44_55.1',
  isSink: true,
  isStream: false,
  audio: {},
  ready: true,
  properties: { 'api.bluez5.address': '00:11:22:33:44:55' }
}
const source = {
  id: 41,
  name: 'bluez_input.00_11_22_33_44_55.0',
  isSink: false,
  isStream: false,
  audio: {},
  ready: true,
  properties: { 'api.bluez5.address': '00:11:22:33:44:55' }
}
assert.equal(model.bluetoothSinkMatchesDevice(sink, device), true)
assert.equal(model.bluetoothSourceMatchesDevice(source, device), true)
assert.equal(model.bluetoothSourceMatchesDevice(sink, device), false)
assert.equal(model.bluetoothSinkMatchesDevice({
  id: 42,
  name: 'bluez_output.unknown',
  isSink: true,
  isStream: false,
  audio: {},
  ready: true,
  properties: { 'node.description': 'Hardware headset' }
}, detailedDevice), true)
assert.equal(model.bluetoothSourceMatchesDevice({
  ...source,
  name: 'bluez_output.00_11_22_33_44_55.1.monitor'
}, device), false)
assert.equal(model.sameAudioNode(sink, { id: 40, name: 'replacement' }), true)
assert.equal(model.sameAudioNode(sink, { id: 42, name: sink.name }), true)
assert.equal(model.sameAudioNode(sink, source), false)
assert.equal(model.preferredAudioNodeName(audioPreferences, 'output', source, [sink]), sink.name)
assert.equal(model.preferredAudioNodeName(audioPreferences, 'output', source, [source]), source.name)
assert.equal(model.currentAudioNodeName(audioPreferences, 'output', source, [sink, source]), source.name)

let failures = model.withDeviceActionFailure(
  {}, '00:11:22:33:44:55', 'connect', 'Connection timed out')
assert.deepEqual(model.deviceActionFailure(failures, '00-11-22-33-44-55'), {
  action: 'connect', message: 'Connection timed out'
})
assert.equal(model.deviceActionReachedState('connect', { connected: true }), true)
assert.equal(model.deviceActionReachedState('disconnect', { connected: false }), true)
assert.equal(model.deviceActionReachedState('forget', {
  paired: false, bonded: false, trusted: false
}), true)
assert.equal(model.deviceActionReachedState('forget', {
  paired: false, bonded: false, trusted: false, blocked: true
}), false)
assert.equal(model.deviceActionReachedState('pair', { connected: false }), false)
failures = model.withDeviceActionFailure(
  failures, '00:11:22:33:44:55', '', '')
assert.equal(model.deviceActionFailure(failures, '00:11:22:33:44:55'), null)

assert.equal(model.deviceIconGlyph('audio-headset', 'Galaxy Buds FEee', true), '󰋋')
assert.equal(model.deviceIconGlyph('audio-headset', 'MOMENTUM 4', false), '󰋋')
assert.equal(model.deviceIconGlyph('audio-card', 'GoogleTV3764', false), '󰍹')
assert.equal(model.deviceIconGlyph('audio-card', 'MiTV-MSSP2', false), '󰍹')
assert.equal(model.deviceIconGlyph('input-keyboard', 'Keychron K2', false), '󰌌')
assert.equal(model.deviceIconGlyph('input-mouse', 'MX Master 3S', false), '󰍽')
assert.equal(model.deviceIconGlyph('input-gaming', 'DualSense', false), '󰊴')
// Glyph constants are verified against the Nerd Font cmap: the watch entry
// previously encoded md-sword (U+f04e5) and rendered as a sword.
assert.deepEqual(
  [...model.deviceIconGlyph('watch', '', false)].map(c => c.codePointAt(0).toString(16)),
  ['f0589'])
assert.deepEqual(
  [...model.deviceIconGlyph('tablet', '', false)].map(c => c.codePointAt(0).toString(16)),
  ['f04f6'])
assert.equal(model.deviceIconGlyph('', 'Unknown Device', true), '󰂱')
assert.equal(model.deviceIconGlyph('', 'Unknown Device', false), '󰂯')

assert.match(panelSource, /pluginScript\("bluetooth-device-action"\)/)
assert.match(panelSource, /device\.cancelPair\(\)/)
assert.match(panelSource, /deviceActionProc\.signal\(15\)/)
assert.match(panelSource, /root\.retryDeviceAction\(dev\)/)
assert.match(panelSource, /Model\.deviceIconGlyph/)
assert.match(panelSource, /pluginScript\("bluetooth-device-property"\)/)
assert.match(panelSource, /id: devicePropertyProc/)
assert.match(panelSource, /id: forgetDialog/)
assert.match(panelSource, /queuePolicyApplications\(/)
assert.match(panelSource, /applyPendingAudioPolicies\(\)/)
assert.match(panelSource, /id: audioPolicyApplyTimer/)
assert.match(panelSource, /detailsAudioPolicyIndex/)
assert.match(panelSource, /id: policyManualButton/)
assert.match(panelSource, /id: policyOutputButton/)
assert.match(panelSource, /id: policyMicButton/)
assert.match(panelSource, /"set-policy"/)
assert.doesNotMatch(panelSource, /!Model\.isValidAudioPolicy\(policy\)/)
assert.match(panelSource, /issuePolicyProfileSwitch\(/)
assert.match(panelSource, /id: policyProfileProc/)
assert.match(panelSource, /policyEntry\(entry,/)
assert.match(panelSource, /stableTicks/)
assert.match(panelSource, /cardSignature/)
assert.match(panelSource, /pluginScript\("bluetooth-audio-profile-set"\)/)
assert.doesNotMatch(panelSource, /pluginScript\("audio-profile-set"\)/)
assert.match(panelSource, /connectPolicyHint/)
assert.match(panelSource, /Model\.duplexProfileOption\(/)
assert.match(panelSource, /deviceDetailsIsAudio/)
assert.match(panelSource, /detailsStopAvailable\(/)
assert.match(panelSource, /Model\.isAudioDevice\(/)
assert.match(panelSource, /syncAudioControlAliases\(/)
assert.match(panelSource, /audioControlScript\("audio-app-rules"\)/)
assert.match(panelSource, /"set-alias"/)
assert.match(panelSource, /parseDeviceAliases\(/)
assert.match(panelSource, /deviceDisplayName\(/)
assert.match(panelSource, /audio-rules\.json/)
assert.doesNotMatch(panelSource, /device\.(?:name|trusted|blocked|wakeAllowed)\s*=/)
assert.doesNotMatch(panelSource, /execDetached\(deviceCommand/)
assert.doesNotMatch(panelSource, /\.isSource\b/)
console.log('PASS: Bluetooth model and panel wiring')
JS

bluetooth_profiles=$(
  AUDIO_CONTROL_CARD_FIXTURE="$TEST_DIR/fixtures/cards.json" \
    PATH="$TEST_DIR/mocks:$PATH" \
    "$ROOT/scripts/bluetooth-audio-profiles"
)

jq -e '
  ."001122334455".card == "bluez_card.00_11_22_33_44_55"
  and ."001122334455".activeCodec == "AAC"
  and [."001122334455".profiles[].label] == [
    "High fidelity · AAC",
    "Headset + microphone · mSBC"
  ]
' <<<"$bluetooth_profiles" >/dev/null || fail "Bluetooth codec discovery"
echo "PASS: Bluetooth codec discovery"

profile_log=$(mktemp)
profile_state=$(mktemp)
bluetooth_action_log=$(mktemp)
bluetooth_action_error=$(mktemp)
bluetooth_property_log=$(mktemp)
bluetooth_property_error=$(mktemp)
shared_preferences=$(mktemp)
failed_preferences=$(mktemp)
no_source_preferences=$(mktemp)
policy_preferences=$(mktemp)
shared_preferences_lock="${shared_preferences}.lock"
failed_preferences_lock="${failed_preferences}.lock"
no_source_preferences_lock="${no_source_preferences}.lock"
policy_preferences_lock="${policy_preferences}.lock"
trap 'rm -f "$profile_log" "$profile_state" "$bluetooth_action_log" "$bluetooth_action_error" "$bluetooth_property_log" "$bluetooth_property_error" "$shared_preferences" "$failed_preferences" "$no_source_preferences" "$policy_preferences" "$shared_preferences_lock" "$failed_preferences_lock" "$no_source_preferences_lock" "$policy_preferences_lock"' EXIT
printf 'old\n' >"$profile_state"

: >"$bluetooth_action_log"
BLUETOOTH_ACTION_LOG="$bluetooth_action_log" \
  PATH="$TEST_DIR/mocks:$PATH" \
  "$ROOT/scripts/bluetooth-device-action" pair 00:11:22:33:44:55
expected_bluetooth_action_log=$(cat <<'EOF'
show
info 00:11:22:33:44:55
pair 00:11:22:33:44:55
trust 00:11:22:33:44:55
connect 00:11:22:33:44:55
EOF
)
[[ $(<"$bluetooth_action_log") == "$expected_bluetooth_action_log" ]] \
  || fail "result-aware Bluetooth pairing sequence"

: >"$bluetooth_action_log"
if BLUETOOTH_ACTION_LOG="$bluetooth_action_log" \
  BLUETOOTH_ACTION_FAIL_COMMAND=pair \
  BLUETOOTH_ACTION_FAIL_MESSAGE='Failed to pair: org.bluez.Error.AuthenticationRejected' \
  PATH="$TEST_DIR/mocks:$PATH" \
  "$ROOT/scripts/bluetooth-device-action" pair 00:11:22:33:44:55 \
    > /dev/null 2>"$bluetooth_action_error"; then
  fail "rejected Bluetooth pairing reported success"
fi
[[ $(<"$bluetooth_action_error") == \
  "Pairing was rejected by the device. Confirm the code and try again." ]] \
  || fail "Bluetooth authentication error mapping"
if rg -q '^(trust|connect) ' "$bluetooth_action_log"; then
  fail "Bluetooth pairing continued after authentication rejection"
fi

: >"$bluetooth_action_log"
if BLUETOOTH_ACTION_LOG="$bluetooth_action_log" \
  BLUETOOTH_ACTION_BLOCKED=yes \
  PATH="$TEST_DIR/mocks:$PATH" \
  "$ROOT/scripts/bluetooth-device-action" connect 00:11:22:33:44:55 \
    > /dev/null 2>"$bluetooth_action_error"; then
  fail "blocked Bluetooth device connection reported success"
fi
[[ $(<"$bluetooth_action_error") == \
  "This device is blocked. Unblock it before trying again." ]] \
  || fail "blocked Bluetooth device error mapping"
if rg -q '^connect ' "$bluetooth_action_log"; then
  fail "blocked Bluetooth device received a connection attempt"
fi

: >"$bluetooth_action_log"
if BLUETOOTH_ACTION_LOG="$bluetooth_action_log" \
  BLUETOOTH_ACTION_POWERED=0 \
  BLUETOOTH_ACTION_POWER_FAIL=1 \
  PATH="$TEST_DIR/mocks:$PATH" \
  "$ROOT/scripts/bluetooth-device-action" connect 00:11:22:33:44:55 \
    > /dev/null 2>"$bluetooth_action_error"; then
  fail "unavailable Bluetooth adapter connection reported success"
fi
[[ $(<"$bluetooth_action_error") == \
  "The Bluetooth adapter could not be powered on." ]] \
  || fail "Bluetooth adapter error mapping"

: >"$bluetooth_action_log"
if BLUETOOTH_ACTION_LOG="$bluetooth_action_log" \
  BLUETOOTH_ACTION_FAIL_COMMAND=connect \
  BLUETOOTH_ACTION_FAIL_MESSAGE='Failed to connect: org.bluez.Error.Failed br-connection-page-timeout' \
  PATH="$TEST_DIR/mocks:$PATH" \
  "$ROOT/scripts/bluetooth-device-action" connect 00:11:22:33:44:55 \
    > /dev/null 2>"$bluetooth_action_error"; then
  fail "unresponsive Bluetooth device connection reported success"
fi
[[ $(<"$bluetooth_action_error") == \
  "The device did not respond. Make sure it is nearby, awake, and not connected elsewhere." ]] \
  || fail "Bluetooth connection timeout error mapping"

: >"$bluetooth_action_log"
BLUETOOTH_ACTION_LOG="$bluetooth_action_log" \
  BLUETOOTH_ACTION_FAIL_COMMAND=disconnect \
  BLUETOOTH_ACTION_FAIL_MESSAGE='Failed to disconnect: org.bluez.Error.Failed' \
  PATH="$TEST_DIR/mocks:$PATH" \
  "$ROOT/scripts/bluetooth-device-action" forget 00:11:22:33:44:55
rg -q '^remove 00:11:22:33:44:55$' "$bluetooth_action_log" \
  || fail "failed disconnect prevented forgetting the Bluetooth device"

: >"$bluetooth_action_log"
BLUETOOTH_ACTION_LOG="$bluetooth_action_log" \
  BLUETOOTH_ACTION_DELAY_COMMAND=pair \
  BLUETOOTH_ACTION_DELAY_SECONDS=2 \
  PATH="$TEST_DIR/mocks:$PATH" \
  "$ROOT/scripts/bluetooth-device-action" pair 00:11:22:33:44:55 \
    > /dev/null 2>"$bluetooth_action_error" &
bluetooth_action_pid=$!
pair_started=false
for (( attempt = 0; attempt < 40; attempt++ )); do
  if rg -q '^pair ' "$bluetooth_action_log"; then
    pair_started=true
    break
  fi
  sleep 0.025
done
[[ $pair_started == true ]] || fail "cancellable Bluetooth pairing did not start"
kill -TERM "$bluetooth_action_pid"
if wait "$bluetooth_action_pid"; then
  fail "cancelled Bluetooth pairing reported success"
fi
if rg -q '^(trust|connect) ' "$bluetooth_action_log"; then
  fail "cancelled Bluetooth pairing continued to trust or connect"
fi
echo "PASS: result-aware Bluetooth device actions"

: >"$bluetooth_property_log"
BLUETOOTH_PROPERTY_LOG="$bluetooth_property_log" \
  PATH="$TEST_DIR/mocks:$PATH" \
  "$ROOT/scripts/bluetooth-device-property" \
    name /org/bluez/hci0/dev_00_11_22_33_44_55 "Desk headset"
[[ $(<"$bluetooth_property_log") == \
  "set-property org.bluez /org/bluez/hci0/dev_00_11_22_33_44_55 org.bluez.Device1 Alias s Desk headset" ]] \
  || fail "Bluetooth device rename property"

: >"$bluetooth_property_log"
BLUETOOTH_PROPERTY_LOG="$bluetooth_property_log" \
  PATH="$TEST_DIR/mocks:$PATH" \
  "$ROOT/scripts/bluetooth-device-property" \
    blocked /org/bluez/hci0/dev_00_11_22_33_44_55 true
rg -q ' org\.bluez\.Device1 Blocked b true$' "$bluetooth_property_log" \
  || fail "Bluetooth boolean device property"

: >"$bluetooth_property_log"
if BLUETOOTH_PROPERTY_LOG="$bluetooth_property_log" \
  BLUETOOTH_PROPERTY_FAIL_PROPERTY=WakeAllowed \
  BLUETOOTH_PROPERTY_FAIL_MESSAGE='Call failed: org.freedesktop.DBus.Error.InvalidArgs' \
  PATH="$TEST_DIR/mocks:$PATH" \
  "$ROOT/scripts/bluetooth-device-property" \
    wakeAllowed /org/bluez/hci0/dev_00_11_22_33_44_55 true \
      > /dev/null 2>"$bluetooth_property_error"; then
  fail "unsupported Bluetooth wake property reported success"
fi
[[ $(<"$bluetooth_property_error") == \
  "This device or Bluetooth adapter does not support wake permission." ]] \
  || fail "unsupported Bluetooth wake property error"
echo "PASS: result-aware Bluetooth device properties"

: >"$bluetooth_property_log"
OMARCHY_AUDIO_PREFERENCES_FILE="$policy_preferences" \
  "$ROOT/scripts/audio-preferences" set-policy 00:11:22:33:44:55 output-mic
jq -e '
  .version == 1
  and .defaults == {"output":"","input":""}
  and .bluetoothProfiles == {}
  and .bluetoothAudioPolicies == {"001122334455":"output-mic"}
' "$policy_preferences" >/dev/null || fail "connect policy persisted"

OMARCHY_AUDIO_PREFERENCES_FILE="$policy_preferences" \
  "$ROOT/scripts/audio-preferences" set-policy AA-BB-CC-DD-EE-FF output
jq -e '.bluetoothAudioPolicies == {
  "001122334455": "output-mic", "aabbccddeeff": "output"
}' "$policy_preferences" >/dev/null || fail "second connect policy persisted"

