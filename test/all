#!/bin/bash

set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
TEST_DIR="$ROOT/test"

fail() {
  echo "FAIL: $*" >&2
  exit 1
}

for script in "$ROOT"/scripts/* "$TEST_DIR"/mocks/*; do
  bash -n "$script" || fail "bash syntax: ${script##*/}"
done
echo "PASS: helper syntax"
python3 "$TEST_DIR/backend.py" || fail "Rust command service"

node - "$ROOT/Model.js" "$ROOT" <<'JS'
