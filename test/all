for (const processId of [
  'audioPolicyPreferenceProc',
  'deviceActionProc',
  'devicePropertyProc',
  'audioProfileSetProc'
]) {
  const processStart = controllerSource.indexOf('id: ' + processId)
  assert.notEqual(processStart, -1)
  const nextProcess = controllerSource.indexOf('\n  Process {', processStart)
  const processBody = controllerSource.slice(processStart,
    nextProcess < 0 ? controllerSource.length : nextProcess)
  assert.match(processBody, /property bool collecting: false/)
  assert.match(processBody, /property bool stderrComplete: false/)
  assert.match(processBody,
    /if \(!collecting \|\| !stderrComplete \|\| !exitComplete\) return/)
  assert.match(controllerSource,
    new RegExp(processId + '\\.prepare\\(\\)'))
}
