#!/bin/bash

if [[ $* == "-f json list cards" && -n ${AUDIO_CONTROL_CARD_FIXTURE:-} ]]; then
  command cat "$AUDIO_CONTROL_CARD_FIXTURE"
  exit 0
fi

if [[ -n ${AUDIO_CONTROL_PROFILE_LOG:-} && -n ${AUDIO_CONTROL_PROFILE_STATE:-} ]]; then
  state=$(<"$AUDIO_CONTROL_PROFILE_STATE")
  card_index=${AUDIO_CONTROL_PROFILE_CARD_INDEX:-10}
  card_name=${AUDIO_CONTROL_PROFILE_CARD_NAME:-bluez_card.00_11_22_33_44_55}

  if [[ ${AUDIO_CONTROL_PROFILE_LEGACY_CARD_FIELD:-0} == 1 ]]; then
    endpoint_card=$(printf '"card":%s' "$card_index")
  else
    endpoint_card=$(printf '"properties":{"device.name":"%s"}' "$card_name")
  fi

  case "$*" in
    "-f json list sinks")
      if [[ $state == old && ${AUDIO_CONTROL_PROFILE_SINK_READ_FAIL:-0} == 1 ]]; then
        exit 1
      fi
      if [[ $state == old ]]; then
        printf '[{"index":100,%s,"volume":{"front-left":{"value_percent":"42%%"}},"mute":false}]\n' "$endpoint_card"
      else
        printf '[{"index":101,%s,"volume":{"front-left":{"value_percent":"100%%"}},"mute":false}]\n' "$endpoint_card"
      fi
      exit 0
      ;;
    "-f json list sources")
      if [[ $state == new && ${AUDIO_CONTROL_PROFILE_NO_NEW_SOURCE:-0} == 1 ]]; then
        printf '[{"index":201,"name":"bluez_output.example.monitor","monitor_source":"bluez_output.example","properties":{"device.name":"%s","media.class":"Audio/Sink"},"volume":{"mono":{"value_percent":"100%%"}},"mute":false}]\n' "$card_name"
      elif [[ $state == old && ${AUDIO_CONTROL_PROFILE_NO_OLD_SOURCE:-0} == 1 ]]; then
        printf '[{"index":201,"name":"bluez_output.example.monitor","monitor_source":"bluez_output.example","properties":{"device.name":"%s","media.class":"Audio/Sink"},"volume":{"mono":{"value_percent":"100%%"}},"mute":false}]\n' "$card_name"
      else
        printf '[{"index":200,%s,"name":"bluez_input.example","monitor_source":"","volume":{"mono":{"value_percent":"36%%"}},"mute":true},{"index":201,"name":"bluez_output.example.monitor","monitor_source":"bluez_output.example","properties":{"device.name":"%s","media.class":"Audio/Sink"},"volume":{"mono":{"value_percent":"100%%"}},"mute":false}]\n' "$endpoint_card" "$card_name"
      fi
      exit 0
      ;;
    "-f json list sink-inputs")
      echo '[{"index":300,"sink":100,"mute":false}]'
      exit 0
      ;;
    set-card-profile\ *)
      printf '%s\n' "$*" >>"$AUDIO_CONTROL_PROFILE_LOG"
      [[ ${AUDIO_CONTROL_PROFILE_SET_FAIL:-0} != 1 ]] || exit 1
      printf 'new\n' >"$AUDIO_CONTROL_PROFILE_STATE"
      exit 0
      ;;
    set-sink-*|set-source-*)
      printf '%s\n' "$*" >>"$AUDIO_CONTROL_PROFILE_LOG"
      exit 0
      ;;
  esac
fi

echo "Unexpected pactl call: $*" >&2
exit 1
