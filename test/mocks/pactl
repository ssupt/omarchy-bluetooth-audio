#!/bin/bash

if [[ $* == "-f json list cards" && -n ${AUDIO_CONTROL_CARD_FIXTURE:-} ]]; then
  command cat "$AUDIO_CONTROL_CARD_FIXTURE"
  exit 0
fi

if [[ -n ${AUDIO_CONTROL_PROFILE_LOG:-} && -n ${AUDIO_CONTROL_PROFILE_STATE:-} ]]; then
  state=$(<"$AUDIO_CONTROL_PROFILE_STATE")
  card_index=${AUDIO_CONTROL_PROFILE_CARD_INDEX:-10}

  case "$*" in
    "-f json list sinks")
      if [[ $state == old ]]; then
        printf '[{"index":100,"card":%s,"volume":{"front-left":{"value_percent":"42%%"}},"mute":false}]\n' "$card_index"
      else
        printf '[{"index":101,"card":%s,"volume":{"front-left":{"value_percent":"100%%"}},"mute":false}]\n' "$card_index"
      fi
      exit 0
      ;;
    "-f json list sources")
      printf '[{"index":200,"card":%s,"volume":{"mono":{"value_percent":"36%%"}},"mute":true}]\n' "$card_index"
      exit 0
      ;;
    "-f json list sink-inputs")
      echo '[{"index":300,"sink":100,"mute":false}]'
      exit 0
      ;;
    set-card-profile\ *)
      printf '%s\n' "$*" >>"$AUDIO_CONTROL_PROFILE_LOG"
      printf 'new\n' >"$AUDIO_CONTROL_PROFILE_STATE"
      exit 0
      ;;
    set-sink-*|set-source-*)
      printf '%s\n' "$*" >>"$AUDIO_CONTROL_PROFILE_LOG"
      exit 0
      ;;
  esac
fi

echo "Unexpected pactl call: $*" >&2
exit 1
